{
  "name": "elemkey",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "start": "node dist/src/server.js",
    "smoke": "node dist/test/deployed-smoke.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "iron-session": "8.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
